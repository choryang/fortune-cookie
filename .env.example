# Neon Postgres 연결 문자열 (Neon 대시보드 > Connection Details)
# 서버리스(HTTP) 드라이버를 쓰므로 pooled / non-pooled 둘 다 동작하지만,
# Neon 이 기본으로 주는 -pooler 가 붙은 문자열을 권장합니다.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키
NUXT_PUBLIC_KAKAO_JS_KEY="여기에_자바스크립트_키"

# 배포된 사이트 URL (OG 태그/공유 링크에 사용). 로컬은 비워두면 localhost 로 동작.
NUXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
